---
/* "Have an Idea?": a private call to action. Ideas are talked through on a call, not posted on the page. */
import { SITE } from "../content/site";
---
<section class="band closing gridded tone tone-cobalt" aria-labelledby="call-title">
  <div class="closing-grid">
    <div class="closing-copy">
      <h2 id="call-title">Have an Idea?</h2>
      <p>Tell me about it. Whether it’s a product, a campaign or a stubborn business problem, a short call is the fastest way to see how we get it from 0 to 1.</p>
    </div>
    <a class="btn btn-lg" id="closing-book" href={SITE.booking} target="_blank" rel="noopener">Book a call <span aria-hidden="true">→</span></a>
  </div>
</section>
